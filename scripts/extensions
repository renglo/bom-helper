#!/usr/bin/env bash
# The extensions CLI moved to ops/renglo-cli (binary: renglo).
set -euo pipefail
ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/../.." && pwd)"
if [[ -x "$ROOT/renglo-cli/renglo-venv/bin/renglo" ]]; then
  exec "$ROOT/renglo-cli/renglo-venv/bin/renglo" extension "$@"
fi
if [[ -x "$ROOT/renglo-cli/scripts/renglo" ]]; then
  exec "$ROOT/renglo-cli/scripts/renglo" extension "$@"
fi
echo "The extensions CLI moved to renglo." >&2
echo "  cd ops/renglo-cli && bash setup_venv.sh && source renglo-venv/bin/activate" >&2
echo "  renglo extension $*" >&2
exit 1
